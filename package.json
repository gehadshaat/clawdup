{
  "name": "clawdup",
  "version": "1.0.16",
  "description": "Automated ClickUp-to-PR pipeline. Polls tasks, runs Claude Code, ships pull requests.",
  "type": "module",
  "bin": {
    "clawdup": "./bin/clawdup.js"
  },
  "preferGlobal": true,
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "clickup",
    "automation",
    "claude",
    "claude-code",
    "github",
    "pull-request",
    "ai",
    "task-automation",
    "devops"
  ],
  "author": "Gehad Shaat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gehadshaat/clawdup.git"
  },
  "homepage": "https://gehadshaat.github.io/clawdup/",
  "bugs": {
    "url": "https://github.com/gehadshaat/clawdup/issues"
  }
}
